# Modèle de backend/.env, qui n'est PAS versionné : sur chaque machine, `cp .env.example .env`.
# Symfony exige que backend/.env existe (même vide) ; il donne les valeurs par défaut du développement.
# Les valeurs propres à une machine et les secrets vont dans backend/.env.local (non versionné non plus),
# qui l'emporte sur .env. Voir DEPLOY.md pour la production.

# Environnement : "dev" par défaut ; "prod" en production (à mettre dans .env.local).
APP_ENV=dev
# Secret qui signe les cookies de connexion. Vide en développement (.env.dev en fournit un).
# En production : 64 caractères aléatoires (php -r "echo bin2hex(random_bytes(32));"), dans .env.local.
APP_SECRET=
APP_SHARE_DIR=var/share

# Adresse du site, pour fabriquer des liens dans les commandes. En production : https://votre-domaine
DEFAULT_URI=http://localhost

# Origines autorisées à appeler l'API depuis un navigateur (expression régulière).
# En production l'application et l'API partagent la même origine : ce réglage n'a alors pas d'effet utile.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Base de données. serverVersion est obligatoire : "8.0" pour MySQL 8, "mariadb-10.11.14" (votre version) pour MariaDB.
DATABASE_URL="mysql://root:@127.0.0.1:3306/codex?serverVersion=8.0&charset=utf8mb4"

# Noms de domaine auxquels le serveur MCP répond (séparés par des virgules).
# En production : y ajouter le nom de domaine public, sinon "Invalid Host header".
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
